{
  "name": "commet",
  "version": "5.1.1",
  "description": "Commet CLI - Manage your billing platform from the command line",
  "bin": {
    "commet": "./bin/commet"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome lint src/",
    "lint:fix": "biome lint --write src/",
    "validate:registry": "tsx scripts/validate-resource-registry.ts",
    "typecheck": "tsc --noEmit && pnpm validate:registry",
    "test:unit": "tsx --test src/commands/agents.test.ts src/commands/doctor.test.ts src/utils/command-name.test.ts",
    "clean": "rm -rf .turbo node_modules dist"
  },
  "keywords": [
    "billing",
    "cli",
    "typescript",
    "commet"
  ],
  "author": "Commet Team",
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "7.29.7",
    "@commet/node": "workspace:*",
    "@inquirer/prompts": "8.5.2",
    "ably": "^2.21.0",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "jiti": "^2.7.0",
    "jsonc-parser": "3.3.1",
    "open": "11.0.0",
    "ora": "9.4.0",
    "semver": "^7.7.4",
    "tar": "^7.5.13"
  },
  "devDependencies": {
    "@types/node": "24.13.1",
    "@types/semver": "^7.7.1",
    "tsup": "8.5.1",
    "tsx": "4.22.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "homepage": "https://commet.co",
  "repository": {
    "type": "git",
    "url": "https://github.com/commet-labs/commet.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
